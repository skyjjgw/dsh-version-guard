{
  "name": "dsh-version-guard",
  "version": "0.1.0",
  "description": "DSH 版本守卫：记录插件版本与配置快照，插件冲突导致 DSH 崩坏后可脱离 DSH 进程回退到上一个可用版本。 · Plugin version guard with an out-of-process recovery page.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skyjjgw/dsh-version-guard.git"
  },
  "homepage": "https://github.com/skyjjgw/dsh-version-guard#readme",
  "bugs": {
    "url": "https://github.com/skyjjgw/dsh-version-guard/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "snapshot",
    "rollback",
    "recovery"
  ],
  "type": "module",
  "main": "lib/host/index.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "dsh-version-guard": "lib/bin/version-guard.js"
  },
  "exports": {
    ".": "./lib/host/index.js",
    "./client": "./lib/client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh-version-guard.cmd",
    "dsh-version-guard.ps1",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
